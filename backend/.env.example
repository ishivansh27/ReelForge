# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file to git.

# --- Database ---
# This matches the docker-compose.yml Postgres service below.
DATABASE_URL=postgresql+psycopg2://reelapp:reelapp_local_password@localhost:5432/reelapp

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme_generate_a_real_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AWS S3 (fill in once we reach the storage phase) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
# Leave blank for real AWS. Only set this to point at a local/mock S3
# endpoint (e.g. moto's test server) or a non-AWS S3-compatible provider.
S3_ENDPOINT_URL=

# --- Stripe (fill in once we reach the payments phase) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- App ---
ENVIRONMENT=development
DEBUG=true
